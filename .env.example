# Postgres user the Compose database is created with
POSTGRES_USER=agent_eval
# Postgres password for that user; change it anywhere other than a laptop
POSTGRES_PASSWORD=agent_eval
# Name of the database Compose creates
POSTGRES_DB=agent_eval
# Host port Postgres is published on (127.0.0.1 only), used by tests run outside Docker
POSTGRES_PORT=5432
# Host port the API is published on (127.0.0.1 only)
API_PORT=8000
# Only for make up-hosted: the domain Caddy gets an HTTPS certificate for, pointing at this server
DOMAIN=
# Connection string for running the API, worker or tests outside Docker; Compose sets its own
DATABASE_URL=postgresql+asyncpg://agent_eval:agent_eval@localhost:5432/agent_eval
# Seconds to wait when opening a database connection before giving up
DB_CONNECT_TIMEOUT_SECONDS=5
# Log level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Log format: json for machines, text for reading in a terminal
LOG_FORMAT=json
# Seconds the worker waits before looking again when the queue is empty or the database is not ready
WORKER_IDLE_SECONDS=1
# Jobs one worker runs at the same time
WORKER_CONCURRENCY=2
# Seconds a job's lease lasts; a worker that stops renewing loses it after this
LEASE_SECONDS=30
# Seconds between lease renewals; must be at most half of LEASE_SECONDS
HEARTBEAT_SECONDS=10
# Seconds between checks for expired leases to recover
RECONCILE_SECONDS=15
# Times a job may be interrupted (its worker crashed or was killed) before it is marked failed
MAX_JOB_ATTEMPTS=3
# Hours a sign-in session lasts before the user must sign in again
SESSION_TTL_HOURS=12
# Send the session cookie over HTTPS only; turn on anywhere other than a laptop
SESSION_COOKIE_SECURE=false
# Hours an invite link stays valid
INVITE_TTL_HOURS=72
# Base64 of 32 random bytes that encrypts stored provider keys. Generate one with:
# python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
APP_MASTER_KEY=
# Where the Gemini API lives; change only to point at a test double
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Seconds one model request may take before it counts as failed and is retried
MODEL_CALL_TIMEOUT_SECONDS=60
# How many times a rate-limited or failed model request is retried before giving up
MODEL_CALL_MAX_RETRIES=4
# Largest trace batch one request may carry, in bytes
INGEST_MAX_BYTES=5000000
# Traces one workspace may send per minute; more are refused with 429 and a Retry-After
INGEST_TRACES_PER_MINUTE=1200
# Share of judged runs, from 0 to 1, put in the review queue for people to label. Borderline runs always go in
REVIEW_SAMPLE_SHARE=0.1
# Show a "Try the demo" button on the sign-in page that opens the demo workspace read-only. Load it first with make demo
DEMO_MODE=false
# Gemini model that writes regression reports. A report can also name its own model
EXPLAINER_MODEL=gemini-3.5-flash
# Only for make test-paid: a Gemini key for the test that calls the real API. Never needed to run the app
GEMINI_API_KEY=
# Only for make test-paid: which Gemini model that test uses
GEMINI_TEST_MODEL=gemini-flash-lite-latest
# Only for make test-paid: the judge model the paid judge test uses
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
