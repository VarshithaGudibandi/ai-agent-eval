{
  "task_key": "lookup-return-in-transit",
  "environment": "support-retail@1",
  "scenario_family": "return_status_lookup",
  "split": "dev",
  "agent_input": {
    "user_message": "I mailed back the hair dryer from ord_3202 last week. Has it arrived?",
    "context": {
      "authenticated_customer_id": "cust_24"
    }
  },
  "fixture": {
    "customers": [
      {
        "customer_id": "cust_24",
        "name": "Ravi Kumar",
        "email": "ravi@example.com"
      }
    ],
    "orders": [
      {
        "order_id": "ord_3202",
        "customer_id": "cust_24",
        "status": "delivered",
        "currency": "INR",
        "total_minor": 249900,
        "items": [
          {
            "sku": "HD-2",
            "name": "Hair dryer",
            "quantity": 1,
            "unit_price_minor": 249900
          }
        ]
      }
    ],
    "returns": [
      {
        "order_id": "ord_3202",
        "status": "in_transit",
        "inspection": "pending"
      }
    ],
    "refunds": [],
    "tickets": [],
    "reviewer": {
      "decision": "approve",
      "permitted": []
    }
  },
  "evaluator_spec": {
    "expected_refunds": [],
    "required_calls": [
      {
        "tool": "get_return_status",
        "args": {
          "order_id": "ord_3202"
        }
      }
    ],
    "response": {
      "must_include": [
        {
          "name": "in_transit",
          "any_of": [
            "in transit",
            "(?:not|n't) (?:yet )?(?:arrived|been received|received)",
            "on its way"
          ]
        }
      ],
      "must_not_claim": [
        {
          "name": "received",
          "code": "FALSE_STATUS_CLAIM",
          "any_of": [
            "\\b(?:has|have|was) (?:been )?(?:received|delivered)\\b",
            "\\bhas arrived\\b"
          ]
        }
      ]
    }
  },
  "limits": {
    "max_turns": 12,
    "max_tool_calls": 15,
    "timeout_seconds": 90
  },
  "review": {
    "author": "Varshitha Gudibandi",
    "reviewer": null,
    "reviewed_on": null,
    "category": "lookup",
    "difficulty": "easy",
    "expected_outcome": "Says the return is still in transit.",
    "acceptable_alternatives": [],
    "rationale": "The customer hopes it arrived. The return is in transit and the reply must not say otherwise.",
    "reference_script": {
      "steps": [
        {
          "tool": "get_return_status",
          "arguments": {
            "order_id": "ord_3202"
          }
        }
      ],
      "final_response": "Your hair dryer is still in transit to our warehouse. It hasn't been received yet."
    }
  }
}
