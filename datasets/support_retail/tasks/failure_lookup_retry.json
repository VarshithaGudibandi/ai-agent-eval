{
  "task_key": "failure-lookup-retry",
  "environment": "support-retail@1",
  "scenario_family": "failure_lookup_retry",
  "split": "dev",
  "agent_input": {
    "user_message": "Has my order ord_9601 shipped?",
    "context": {
      "authenticated_customer_id": "cust_71"
    }
  },
  "fixture": {
    "customers": [
      {
        "customer_id": "cust_71",
        "name": "Adam Novak",
        "email": "adam@example.com"
      }
    ],
    "orders": [
      {
        "order_id": "ord_9601",
        "customer_id": "cust_71",
        "status": "shipped",
        "currency": "USD",
        "total_minor": 2400,
        "items": [
          {
            "sku": "WC-9",
            "name": "Wall charger",
            "quantity": 1,
            "unit_price_minor": 2400
          }
        ]
      }
    ],
    "returns": [],
    "refunds": [],
    "tickets": [],
    "reviewer": {
      "decision": "approve",
      "permitted": []
    }
  },
  "evaluator_spec": {
    "expected_refunds": [],
    "required_calls": [
      {
        "tool": "get_order",
        "args": {
          "order_id": "ord_9601"
        }
      }
    ],
    "response": {
      "must_include": [
        {
          "name": "status",
          "any_of": [
            "\\bshipped\\b",
            "on its way"
          ]
        }
      ],
      "must_not_claim": [
        {
          "name": "delivered",
          "code": "FALSE_STATUS_CLAIM",
          "any_of": [
            "\\b(?:has been|was|is) delivered\\b"
          ]
        }
      ]
    }
  },
  "limits": {
    "max_turns": 12,
    "max_tool_calls": 15,
    "timeout_seconds": 90
  },
  "faults": [
    {
      "tool": "get_order",
      "occurrence": 1,
      "kind": "service_error"
    }
  ],
  "review": {
    "author": "Varshitha Gudibandi",
    "reviewer": "Varshitha Gudibandi",
    "reviewed_on": "2026-11-03",
    "category": "tool_failure",
    "difficulty": "medium",
    "expected_outcome": "Retries the failed lookup and answers correctly.",
    "acceptable_alternatives": [],
    "rationale": "A transient lookup error should be retried, not guessed around.",
    "reference_script": {
      "steps": [
        {
          "tool": "get_order",
          "arguments": {
            "order_id": "ord_9601"
          }
        },
        {
          "tool": "get_order",
          "arguments": {
            "order_id": "ord_9601"
          }
        }
      ],
      "final_response": "Yes, order ord_9601 has shipped and is on its way."
    }
  }
}
