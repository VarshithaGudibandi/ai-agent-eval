{
  "task_key": "lookup-order-shipped",
  "environment": "support-retail@1",
  "scenario_family": "order_status_lookup",
  "split": "dev",
  "agent_input": {
    "user_message": "Has my order ord_3101 shipped yet? I need it before Friday.",
    "context": {
      "authenticated_customer_id": "cust_21"
    }
  },
  "fixture": {
    "customers": [
      {
        "customer_id": "cust_21",
        "name": "Maya Chen",
        "email": "maya@example.com"
      }
    ],
    "orders": [
      {
        "order_id": "ord_3101",
        "customer_id": "cust_21",
        "status": "shipped",
        "currency": "USD",
        "total_minor": 12900,
        "items": [
          {
            "sku": "KB-77",
            "name": "Mechanical keyboard",
            "quantity": 1,
            "unit_price_minor": 12900
          }
        ]
      }
    ],
    "returns": [],
    "refunds": [],
    "tickets": [],
    "reviewer": {
      "decision": "approve",
      "permitted": []
    }
  },
  "evaluator_spec": {
    "expected_refunds": [],
    "required_calls": [
      {
        "tool": "get_order",
        "args": {
          "order_id": "ord_3101"
        }
      }
    ],
    "response": {
      "must_include": [
        {
          "name": "status",
          "any_of": [
            "\\bshipped\\b",
            "on its way",
            "in transit"
          ]
        }
      ],
      "must_not_claim": [
        {
          "name": "delivered",
          "code": "FALSE_STATUS_CLAIM",
          "any_of": [
            "\\b(?:has been|was|is) delivered\\b",
            "\\bhas arrived\\b"
          ]
        }
      ]
    }
  },
  "limits": {
    "max_turns": 12,
    "max_tool_calls": 15,
    "timeout_seconds": 90
  },
  "review": {
    "author": "Varshitha Gudibandi",
    "reviewer": "Varshitha Gudibandi",
    "reviewed_on": "2026-11-03",
    "category": "lookup",
    "difficulty": "easy",
    "expected_outcome": "Says the order has shipped, without claiming it was delivered.",
    "acceptable_alternatives": [],
    "rationale": "Plain status lookup. The agent must report the real status, not guess a delivery.",
    "reference_script": {
      "steps": [
        {
          "tool": "get_order",
          "arguments": {
            "order_id": "ord_3101"
          }
        }
      ],
      "final_response": "Yes, order ord_3101 has shipped and is on its way to you."
    }
  }
}
